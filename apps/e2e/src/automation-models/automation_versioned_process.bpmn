          </camunda:inputParameter>
          <camunda:outputParameter name="textField">${textField}</camunda:outputParameter>
          <camunda:outputParameter name="associateId">${associateId}</camunda:outputParameter>
          <camunda:outputParameter name="nonRequiredTextField">${nonRequiredTextField}</camunda:outputParameter>
          <camunda:outputParameter name="dataMap">${dataMap}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
