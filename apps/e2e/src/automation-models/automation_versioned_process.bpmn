<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fluxnova="http://fluxnova.finos.org/schema/1.0/bpmn" xmlns:modeler="http://fluxnova.finos.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Fluxnova Modeler" exporterVersion="1.2.0" modeler:executionPlatform="Fluxnova Platform" modeler:executionPlatformVersion="2.0.0">
  <bpmn:process id="fluxnova_automation_versioned_process" name="Fluxnova UI Automation - Versioned Process" isExecutable="true" camunda:historyTimeToLive="7">
    <bpmn:startEvent id="StartEvent_1" camunda:formKey="{   &#34;components&#34;: [     {       &#34;label&#34;: &#34;Text Field&#34;,       &#34;key&#34;: &#34;textField&#34;,       &#34;type&#34;: &#34;textfield&#34;,       &#34;input&#34;: true,       &#34;tableView&#34;: true     },     {       &#34;label&#34;: &#34;Associate&#34;,       &#34;tableView&#34;: true,       &#34;key&#34;: &#34;associateId&#34;,       &#34;logic&#34;: [         {           &#34;name&#34;: &#34;on change get associate&#34;,           &#34;trigger&#34;: {             &#34;type&#34;: &#34;event&#34;,             &#34;event&#34;: &#34;change&#34;           },           &#34;actions&#34;: [             {               &#34;name&#34;: &#34;get associate name&#34;,               &#34;type&#34;: &#34;customAction&#34;,               &#34;customAction&#34;: &#34;if (data &#38;&#38; data.associate &#38;&#38; data.associate.id !== data.associateId) {\n  delete data.associate;\n  instance.triggerChange();\n}\n\nif (data &#38;&#38; data.associateId &#38;&#38; data.associateId.length === 7 &#38;&#38; (!data.associate || data.associate.id !== data.associateId)) {\n  window.fluxnovaIntegration.execute(&#39;people-central&#39;, {        \n    associateNumber: data.associateId,\n    filterFields: &#39;FIRST_NAME,LAST_NAME&#39;\n  })\n    .then(result =&#62; {\n      console.log(&#39;got an associate back&#39;, result);\n      data.associate = result.data;\n      data.associate.id = data.associateId\n      instance.triggerChange();\n    })\n    .catch(err =&#62; {\n      console.log(&#39;could not get associate&#39;, err);\n    });  \n}\n&#34;             }           ]         }       ],       &#34;type&#34;: &#34;textfield&#34;,       &#34;input&#34;: true     },     {       &#34;label&#34;: &#34;HTML&#34;,       &#34;attrs&#34;: [         {           &#34;attr&#34;: &#34;&#34;,           &#34;value&#34;: &#34;&#34;         }       ],       &#34;content&#34;: &#34;Hello {{data.associate.firstName}} {{data.associate.lastName}}!&#34;,       &#34;refreshOnChange&#34;: true,       &#34;key&#34;: &#34;html&#34;,       &#34;conditional&#34;: {         &#34;when&#34;: &#34;associate&#34;       },       &#34;customConditional&#34;: &#34;show = !!data &#38;&#38; !!data.associate&#34;,       &#34;type&#34;: &#34;htmlelement&#34;,       &#34;input&#34;: false,       &#34;tableView&#34;: false     },     {       &#34;label&#34;: &#34;Non-required Text Field&#34;,       &#34;tableView&#34;: true,       &#34;validate&#34;: {         &#34;required&#34;: false       },       &#34;key&#34;: &#34;nonRequiredTextField&#34;,       &#34;type&#34;: &#34;textfield&#34;,       &#34;input&#34;: true     },     {       &#34;label&#34;: &#34;Data Map&#34;,       &#34;tableView&#34;: false,       &#34;key&#34;: &#34;dataMap&#34;,       &#34;type&#34;: &#34;datamap&#34;,       &#34;input&#34;: true,       &#34;valueComponent&#34;: {         &#34;type&#34;: &#34;textfield&#34;,         &#34;key&#34;: &#34;value&#34;,         &#34;label&#34;: &#34;Value&#34;,         &#34;input&#34;: true,         &#34;hideLabel&#34;: true,         &#34;tableView&#34;: true       }     },     {       &#34;label&#34;: &#34;Client Only Text Field&#34;,       &#34;tableView&#34;: true,       &#34;persistent&#34;: &#34;client-only&#34;,       &#34;key&#34;: &#34;clientOnlyTextField&#34;,       &#34;type&#34;: &#34;textfield&#34;,       &#34;input&#34;: true     }   ] }">
      <bpmn:outgoing>Flow_0a87m05</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0a87m05" sourceRef="StartEvent_1" targetRef="Gateway_06dqy7l" />
    <bpmn:userTask id="userTask1" name="Fluxnova UI Automation - Versioned Process Results" camunda:asyncAfter="true" camunda:formKey="{   &#34;components&#34;: [     {       &#34;label&#34;: &#34;Text Field&#34;,       &#34;key&#34;: &#34;textField&#34;,       &#34;type&#34;: &#34;textfield&#34;,       &#34;input&#34;: true,       &#34;tableView&#34;: true     },     {       &#34;label&#34;: &#34;Associate&#34;,       &#34;tableView&#34;: true,       &#34;key&#34;: &#34;associateId&#34;,       &#34;logic&#34;: [         {           &#34;name&#34;: &#34;on change get associate&#34;,           &#34;trigger&#34;: {             &#34;type&#34;: &#34;event&#34;,             &#34;event&#34;: &#34;change&#34;           },           &#34;actions&#34;: [             {               &#34;name&#34;: &#34;get associate name&#34;,               &#34;type&#34;: &#34;customAction&#34;,               &#34;customAction&#34;: &#34;if (data &#38;&#38; data.associate &#38;&#38; data.associate.id !== data.associateId) {\n  delete data.associate;\n  instance.triggerChange();\n}\n\nif (data &#38;&#38; data.associateId &#38;&#38; data.associateId.length === 7 &#38;&#38; (!data.associate || data.associate.id !== data.associateId)) {\n  window.fluxnovaIntegration.execute(&#39;people-central&#39;, {        \n    associateNumber: data.associateId,\n    filterFields: &#39;FIRST_NAME,LAST_NAME&#39;\n  })\n    .then(result =&#62; {\n      console.log(&#39;got an associate back&#39;, result);\n      data.associate = result.data;\n      data.associate.id = data.associateId\n      instance.triggerChange();\n    })\n    .catch(err =&#62; {\n      console.log(&#39;could not get associate&#39;, err);\n    });  \n}\n&#34;             }           ]         }       ],       &#34;type&#34;: &#34;textfield&#34;,       &#34;input&#34;: true     },     {       &#34;label&#34;: &#34;HTML&#34;,       &#34;attrs&#34;: [         {           &#34;attr&#34;: &#34;&#34;,           &#34;value&#34;: &#34;&#34;         }       ],       &#34;content&#34;: &#34;Hello {{data.associate.firstName}} {{data.associate.lastName}}!&#34;,       &#34;refreshOnChange&#34;: true,       &#34;key&#34;: &#34;html&#34;,       &#34;conditional&#34;: {         &#34;when&#34;: &#34;associate&#34;       },       &#34;customConditional&#34;: &#34;show = !!data &#38;&#38; !!data.associate&#34;,       &#34;type&#34;: &#34;htmlelement&#34;,       &#34;input&#34;: false,       &#34;tableView&#34;: false     },     {       &#34;label&#34;: &#34;Non-required Text Field&#34;,       &#34;tableView&#34;: true,       &#34;validate&#34;: {         &#34;required&#34;: false       },       &#34;key&#34;: &#34;requiredTextField&#34;,       &#34;type&#34;: &#34;textfield&#34;,       &#34;input&#34;: true     },     {       &#34;label&#34;: &#34;Data Map&#34;,       &#34;tableView&#34;: false,       &#34;key&#34;: &#34;dataMap&#34;,       &#34;type&#34;: &#34;datamap&#34;,       &#34;input&#34;: true,       &#34;valueComponent&#34;: {         &#34;type&#34;: &#34;textfield&#34;,         &#34;key&#34;: &#34;value&#34;,         &#34;label&#34;: &#34;Value&#34;,         &#34;input&#34;: true,         &#34;hideLabel&#34;: true,         &#34;tableView&#34;: true       }     },     {       &#34;label&#34;: &#34;Client Only Text Field&#34;,       &#34;tableView&#34;: true,       &#34;persistent&#34;: &#34;client-only&#34;,       &#34;key&#34;: &#34;clientOnlyTextField&#34;,       &#34;type&#34;: &#34;textfield&#34;,       &#34;input&#34;: true     }   ] }">
      <bpmn:extensionElements>
        <camunda:inputOutput>
