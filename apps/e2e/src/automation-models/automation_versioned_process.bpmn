            <camunda:script scriptFormat="javascript">execution.getVariable('textField') || ''</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="associateId">
            <camunda:script scriptFormat="javascript">execution.getVariable('associateId') || ''</camunda:script>
          </camunda:inputParameter>
