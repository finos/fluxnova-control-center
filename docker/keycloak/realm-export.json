{
  "realm": "fluxnova",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "fluxnova-control-center",
      "secret": "control-center-secret",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": ["http://localhost:4000/*", "https://localhost:4000/*"],
      "webOrigins": ["http://localhost:4000", "https://localhost:4000"],
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "preferred_username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "Allows the user to request offline tokens"
      },
      {
        "name": "designer",
        "description": "FluxNova Designer role"
      },
      {
        "name": "reader",
        "description": "FluxNova Reader role"
      }
    ]
  },
  "users": [
    {
      "username": "demo",
      "firstName": "Demo",
      "lastName": "Demo",
      "email": "demo@fluxnova.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "groups": ["/sales", "/accounting", "/management", "/fluxnova-admin"],
      "requiredActions": [],
      "realmRoles": ["offline_access"]
    },
    {
      "username": "john",
      "firstName": "John",
      "lastName": "Doe",
      "email": "john@fluxnova.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "john",
          "temporary": false
        }
      ],
      "groups": ["/sales"],
      "requiredActions": [],
      "realmRoles": ["offline_access"]
    },
    {
      "username": "mary",
      "firstName": "Mary",
      "lastName": "Anne",
      "email": "mary@fluxnova.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "mary",
          "temporary": false
        }
      ],
      "groups": ["/accounting"],
      "requiredActions": [],
      "realmRoles": ["offline_access"]
    },
    {
      "username": "peter",
      "firstName": "Peter",
      "lastName": "Meter",
      "email": "peter@fluxnova.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "peter",
          "temporary": false
        }
      ],
      "groups": ["/management"],
      "requiredActions": [],
      "realmRoles": ["offline_access"]
    }
  ],
  "groups": [
    {
      "name": "sales",
      "path": "/sales"
    },
    {
      "name": "accounting",
      "path": "/accounting"
    },
    {
      "name": "management",
      "path": "/management"
    },
    {
      "name": "fluxnova-admin",
      "path": "/fluxnova-admin"
    }
  ]
}
