{
  "name": "fluxnova-control-center",
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "ng": "nx",
    "format": "./node_modules/.bin/nx format:write && pnpm prettier && ./node_modules/.bin/nx lint --fix",
    "prettier": "./node_modules/.bin/prettier --write \"**/*.{js,json,css,scss,md,ts,html,component.html}\"",
    "start": "./node_modules/.bin/nx run-many --parallel --target=serve --projects=server,frontend --maxParallel=2 --configuration=development",
    "start:env": "vault agent -config=./scripts/vault/agent-config.hcl -log-level=info",
    "build": "ng build",
    "postbuild": "npx pnpm run compress",
    "compress": "gzipper compress ./dist/apps/frontend --brotli --gzip",
    "test": "TZ=UTC ng test",
    "test:all": "TZ=UTC ./node_modules/.bin/nx run-many --target=test --all --parallel --maxParallel=4",
    "lint": "./node_modules/.bin/nx affected:lint",
    "ts-script": "npx ts-node -r tsconfig-paths/register --project scripts/tsconfig.json",
    "frontend-bundle-report": "ng build frontend --configuration production --stats-json && webpack-bundle-analyzer dist/apps/frontend/stats.json",
    "server-bundle-report": "ng build server --configuration production --stats-json && webpack-bundle-analyzer dist/apps/server/stats.json",
    "publish": "./scripts/publish.sh",
    "affected:apps": "./node_modules/.bin/nx affected:apps --base=remotes/origin/develop",
    "affected:libs": "./node_modules/.bin/nx affected:libs --base=remotes/origin/develop",
    "affected:build": "./node_modules/.bin/nx affected:build --base=remotes/origin/develop",
    "affected:e2e": "./node_modules/.bin/nx affected:e2e --base=remotes/origin/develop",
    "affected:test": "TZ=UTC ./node_modules/.bin/nx affected:test --base=remotes/origin/develop",
    "affected:lint": "./node_modules/.bin/nx affected:lint --base=remotes/origin/develop --parallel=true --maxParallel=4",
    "affected:dep-graph": "./node_modules/.bin/nx affected:dep-graph --base=remotes/origin/develop",
    "affected": "./node_modules/.bin/nx affected --base=remotes/origin/develop",
    "e2e:env": "vault agent -config=./scripts/vault/agent-config.e2e.hcl -log-level=info",
    "e2e": "mkdir -p apps/e2e/.auth && npx playwright test -c apps/e2e/playwright.config.ts --project e2e",
    "e2e-ui": "mkdir -p apps/e2e/.auth && npx playwright test -c apps/e2e/playwright.config.ts --project e2e --ui",
    "e2e-debug": "mkdir -p apps/e2e/.auth && npx playwright test -c apps/e2e/playwright.config.ts --project e2e --debug",
    "me2e": "mkdir -p apps/e2e/.auth && npx playwright test -c apps/e2e/playwright.config.ts --project me2e",
    "me2e-ui": "mkdir -p apps/e2e/.auth && npx playwright test -c apps/e2e/playwright.config.ts --project me2e --ui",
    "me2e-debug": "mkdir -p apps/e2e/.auth && npx playwright test -c apps/e2e/playwright.config.ts --project me2e --debug",
    "reg": "mkdir -p apps/e2e/.auth &&  npx playwright test -c apps/e2e/playwright.config.ts --project regression",
    "reg:bd": "mkdir -p apps/e2e/.auth &&  npx playwright test apps/e2e/src/regression/batch-details -c apps/e2e/playwright.config.ts --project regression",
    "reg:bl": "mkdir -p apps/e2e/.auth &&  npx playwright test apps/e2e/src/regression/batches-list -c apps/e2e/playwright.config.ts --project regression",
    "reg:ddd": "mkdir -p apps/e2e/.auth &&  npx playwright test apps/e2e/src/regression/decision-definition-details -c apps/e2e/playwright.config.ts --project regression",
    "reg:ddl": "mkdir -p apps/e2e/.auth &&  npx playwright test apps/e2e/src/regression/decision-definitions-list -c apps/e2e/playwright.config.ts --project regression",
    "reg:dd": "mkdir -p apps/e2e/.auth &&  npx playwright test apps/e2e/src/regression/deployment-details -c apps/e2e/playwright.config.ts --project regression",
    "reg:dl": "mkdir -p apps/e2e/.auth &&  npx playwright test apps/e2e/src/regression/deployments-list -c apps/e2e/playwright.config.ts --project regression",
    "reg:il": "mkdir -p apps/e2e/.auth &&  npx playwright test apps/e2e/src/regression/incidents-list -c apps/e2e/playwright.config.ts --project regression",
    "reg:jl": "mkdir -p apps/e2e/.auth &&  npx playwright test apps/e2e/src/regression/jobs-list -c apps/e2e/playwright.config.ts --project regression",
    "reg:pdd": "mkdir -p apps/e2e/.auth &&  npx playwright test apps/e2e/src/regression/process-definition-details -c apps/e2e/playwright.config.ts --project regression",
    "reg:pdl": "mkdir -p apps/e2e/.auth &&  npx playwright test apps/e2e/src/regression/process-definitions-list -c apps/e2e/playwright.config.ts --project regression",
    "reg:pid": "mkdir -p apps/e2e/.auth &&  npx playwright test apps/e2e/src/regression/process-instance-details -c apps/e2e/playwright.config.ts --project regression",
    "reg:pil": "mkdir -p apps/e2e/.auth &&  npx playwright test apps/e2e/src/regression/process-instances-list -c apps/e2e/playwright.config.ts --project regression",
    "reg-ui": "mkdir -p apps/e2e/.auth &&  npx playwright test -c apps/e2e/playwright.config.ts --project regression --ui",
    "reg-debug": "mkdir -p apps/e2e/.auth &&  npx playwright test -c apps/e2e/playwright.config.ts --project regression --debug",
    "format:write": "./node_modules/.bin/nx format:write",
    "format:check": "./node_modules/.bin/nx format:check",
    "update": "nx migrate latest",
    "update:check": "ng update",
    "dep-graph": "./node_modules/.bin/nx dep-graph",
    "help": "./node_modules/.bin/nx help",
    "nx": "nx",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "node decorate-angular-cli.cjs",
    "workspace-generator": "nx workspace-generator",
    "prepare": "husky",
    "generate-fluxnova-client": "scripts/generate-fluxnova-client.sh"
  },
